# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Dylan Wave AI
NEXT_PUBLIC_APP_DESCRIPTION=AI-powered trading platform

# Backend Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dylan_wave_ai
DATABASE_TEST_URL=postgresql://user:password@localhost:5432/dylan_wave_ai_test

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Redis Configuration (optional for caching)
REDIS_URL=redis://localhost:6379

# Environment
ENVIRONMENT=development
DEBUG=True
